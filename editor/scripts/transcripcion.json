 "segments": [
  {
   "start": 0.0,
   "end": 2.76,
   "text": "Bienvenidas al reto de 21 días con Beleza."
  },
  {
   "start": 2.92,
   "end": 10.1,
   "text": "Durante las próximas 3 semanas aprenderás a usar tu Luma Body con nuestro aceite para masajes de forma gradual"
  },
  {
   "start": 10.1,
   "end": 15.14,
   "text": "y podrás hacer uso de 15 minutos diarios que podrás convertir en rutina para ti."
  },
  {
   "start": 15.3,
   "end": 21.86,
   "text": "No recibiste solamente un producto, también recibirás una guía donde sabrás qué rutina realizar cada día,"
  },
  {
   "start": 22.36,
   "end": 26.16,
   "text": "cómo usar este producto y cómo avanzar según tu tolerancia."
  },
  {
   "start": 26.92,
   "end": 29.52,
   "text": "En la primera semana aprenderemos la técnica."
  },
  {
   "start": 30.0,
   "end": 37.02,
   "text": "En la segunda aumentaremos el tiempo de trabajo y en la tercera integraremos diferentes zonas del cuerpo."
  },
  {
   "start": 37.34,
   "end": 45.24,
   "text": "No necesitas hacerlo perfecto, solo necesitas ser constante, escuchar tu cuerpo y completar esos 15 minutos diarios."
  },
  {
   "start": 45.5,
   "end": 50.32,
   "text": "Recuerda guardar el calendario en tu celular o imprímelo para más facilidad."
  },
  {
   "start": 50.98,
   "end": 57.22,
   "text": "Además, adecua muy bien el espacio donde vas a hacer tu rutina de masajes y acompáñame a comenzar el primer día."
  }
 ],
