{
 "model": "large-v3-turbo",
 "duration": 68.5426875,
 "segments": [
  {
   "start": 1.3600000000000003,
   "end": 5.9,
   "text": "Antes de comenzar a utilizar tu LumaBody, aprendamos a manejar sus tres botones."
  },
  {
   "start": 6.32,
   "end": 13.12,
   "text": "El primero es el botón de Power. Presiónalo una vez para encender o apagar el dispositivo."
  },
  {
   "start": 13.76,
   "end": 21.3,
   "text": "El segundo es el botón Heat. Al activarlo, se enciende la luz roja y comienza la función de calor."
  },
  {
   "start": 21.84,
   "end": 29.3,
   "text": "Puedes ajustar su intensidad según tu comodidad. Entre mayor sea el nivel, más calor sentirá sobre la piel."
  },
  {
   "start": 30.040000000000003,
   "end": 40.6,
   "text": "El tercer botón es el Negative Pressure, con el que regulas el nivel de succión."
  },
  {
   "start": 40.94,
   "end": 44.26,
   "text": "Cada vez que lo presiones, la intensidad de succión aumentará."
  },
  {
   "start": 45.08,
   "end": 50.64,
   "text": "Si es tu primera vez utilizando Luma Body, comienza entre los niveles 1 a 3."
  },
  {
   "start": 51.62,
   "end": 56.14,
   "text": "Prueba siempre desde el nivel más bajo y aumenta gradualmente según lo que tu piel tolere."
  },
  {
   "start": 57.1,
   "end": 60.26,
   "text": "Recuerda, debes sentir la succión, pero nunca dolor"
  },
  {
   "start": 60.26,
   "end": 63.46,
   "text": "Si se siente demasiado fuerte, baja la intensidad"
  },
  {
   "start": 63.46,
   "end": 67.14,
   "text": "Aplica más aceite y mantén el dispositivo en movimiento"
  }
 ],
