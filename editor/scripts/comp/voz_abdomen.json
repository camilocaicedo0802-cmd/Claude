 "segments": [
  {
   "start": 1.8200000000000003,
   "end": 7.92,
   "text": "Ahora vamos a preparar el abdomen."
  },
  {
   "start": 8.42,
   "end": 14.98,
   "text": "Antes de comenzar con nuestra rutina de Luma Body, vamos a preparar suavemente la piel con un pequeño masaje manual."
  },
  {
   "start": 15.78,
   "end": 21.92,
   "text": "Aplica suficiente aceite en las manos y frótalas entre sí para distribuirlo y calentarlo ligeramente."
  },
  {
   "start": 22.84,
   "end": 27.2,
   "text": "Ahora, ubica las manos en la parte baja del abdomen, cerca de la zona inguinal"
  },
  {
   "start": 27.2,
   "end": 30.92,
   "text": "Y realiza movimientos circulares muy suaves"
  },
  {
   "start": 31.94,
   "end": 35.06,
   "text": "Deslizando las manos desde los costados hacia el frente"
  },
  {
   "start": 36.699999999999996,
   "end": 39.72,
   "text": "Deslizando las manos desde los costados hacia el frente"
  },
  {
   "start": 41.4,
   "end": 43.18,
   "text": "No necesitas hacer fuerza"
  },
  {
   "start": 43.18,
   "end": 46.68,
   "text": "La presión debe ser ligera, lenta y muy cómoda"
  },
  {
   "start": 46.68,
   "end": 52.3,
   "text": "Después lleva las manos hacia el abdomen y realiza círculos amplios alrededor del ombligo"
  },
  {
   "start": 52.3,
   "end": 54.74,
   "text": "sin presionar directamente sobre él"
  },
  {
   "start": 54.74,
   "end": 59.42,
   "text": "Acompaña el movimiento con respiraciones lentas y profundas para relajar la zona"
  },
  {
   "start": 59.42,
   "end": 63.6,
   "text": "Repite esta preparación durante 1 o 2 minutos"
  },
  {
   "start": 63.6,
   "end": 68.6,
   "text": "y cuando la piel tenga suficiente deslizamiento continúa con tu rutina de Luma Ode"
  }
 ],
