 "segments": [
  {
   "start": 0.0,
   "end": 1.04,
   "text": "Creo que tengo algo."
  },
  {
   "start": 1.26,
   "end": 3.04,
   "text": "Lo oigo chicos, creo que agarró otro."
  },
  {
   "start": 3.42,
   "end": 4.18,
   "text": "¿Qué pasa?"
  },
  {
   "start": 4.38,
   "end": 6.14,
   "text": "Ahí vamos, creo que ha agarrado otro presente."
  },
  {
   "start": 8.4,
   "end": 9.96,
   "text": "¡Ahí está! ¡Ahí está!"
  },
  {
   "start": 11.76,
   "end": 12.28,
   "text": "¿Tiburón?"
  },
  {
   "start": 12.4,
   "end": 13.36,
   "text": "¿Tienes un tiburón?"
  },
  {
   "start": 16.26,
   "end": 16.78,
   "text": "¡Capitán!"
  },
  {
   "start": 17.66,
   "end": 18.78,
   "text": "¡Ese es un tiburón!"
  },
  {
   "start": 19.02,
   "end": 19.84,
   "text": "¡Oh, sí lo tenemos!"
  },
  {
   "start": 20.22,
   "end": 22.34,
   "text": "Es un tiburón nariz apilado del Atlántico."
  },
  {
   "start": 22.42,
   "end": 23.54,
   "text": "Tiene dientes pequeños."
  },
  {
   "start": 23.8,
   "end": 24.96,
   "text": "Veamos qué tamaño tiene."
  },
  {
   "start": 26.22,
   "end": 27.92,
   "text": "4,7 libras."
  },
  {
   "start": 27.92,
   "end": 30.02,
   "text": "Bien, no está mal, no está mal."
  },
  {
   "start": 30.02,
   "end": 33.08,
   "text": "No es suficiente, pero necesitamos capturarlas. Sigamos."
  },
  {
   "start": 33.4,
   "end": 35.62,
   "text": "Venga, otro equipo. Pesca, nos da energía."
  },
  {
   "start": 36.04,
   "end": 37.66,
   "text": "Pescamos otro pez, muy rápido."
  },
  {
   "start": 38.06,
   "end": 39.72,
   "text": "Dios mío, ¿por qué tenemos que hacer esto?"
  },
  {
   "start": 39.82,
   "end": 42.76,
   "text": "Vamos, es gigante. Vamos, hay que girar, girar."
  },
  {
   "start": 42.78,
   "end": 44.56,
   "text": "Oh, Dios mío, es enorme."
  },
  {
   "start": 44.96,
   "end": 45.6,
   "text": "Vamos, Jenny."
  },
  {
   "start": 46.2,
   "end": 47.32,
   "text": "Enrolla, enrolla, enrolla."
  },
  {
   "start": 47.78,
   "end": 49.66,
   "text": "Mírenme, mirenme, mirenme, mirenme, mirenme."
  },
  {
   "start": 49.72,
   "end": 51.02,
   "text": "Ya casi está aquí."
  },
  {
   "start": 52.28,
   "end": 53.14,
   "text": "Mírenlo, ahí está."
  },
  {
   "start": 53.56,
   "end": 55.72,
   "text": "Sosten esto y yo os arreglaré, ¿ok?"
  },
  {
   "start": 55.72,
   "end": 56.64,
   "text": "¿Qué? ¡Ay, por Dios!"
  },
  {
   "start": 58.34,
   "end": 59.46,
   "text": "¡Judy! ¡Enrolla!"
  },
  {
   "start": 61.879999999999995,
   "end": 66.58,
   "text": "No esperábamos un pez tan grande. Ahora es un problema porque no podemos sacarlo."
  },
  {
   "start": 66.78,
   "end": 67.58,
   "text": "¡Sí! ¡Vamos!"
  },
  {
   "start": 68.24,
   "end": 70.44,
   "text": "¡Por fin lo tengo! ¡Ya está en posición!"
  },
  {
   "start": 75.98,
   "end": 79.66,
   "text": "Así chicos, hemos venido a otro sitio y esperamos que nos pasen."
  },
  {
   "start": 79.66,
   "end": 86.08,
   "text": "Tenemos tiempo, estamos en un sitio muy bueno, hay un antiguo justo debajo de nosotros y un montón de peces."
  },
  {
   "start": 86.52,
   "end": 91.84,
   "text": "Chicos, la verdad es que estoy emocionado, es un pez muy grande, vamos a ver."
  },
  {
   "start": 95.06,
   "end": 97.56,
   "text": "Es un pez que la vas por ahí, no quiere pesarlo."
  }
 ],
