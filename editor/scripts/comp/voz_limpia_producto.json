{
 "model": "large-v3",
 "duration": 52.7946875,
 "segments": [
  {
   "start": 0.0,
   "end": 4.18,
   "text": "Antes de comenzar a utilizar tu LumaBody, aprendamos a manejar sus tres botones."
  },
  {
   "start": 4.28,
   "end": 10.24,
   "text": "El primero es el botón de Power. Presiónalo una vez para encender o apagar el dispositivo."
  },
  {
   "start": 10.36,
   "end": 17.18,
   "text": "El segundo es el botón Heat. Al activarlo, se enciende la luz roja y comienza la función de calor."
  },
  {
   "start": 17.42,
   "end": 24.1,
   "text": "Puedes ajustar su intensidad según tu comodidad. Entre mayor sea el nivel, más calor sentirás sobre la piel."
  },
  {
   "start": 24.28,
   "end": 28.44,
   "text": "El tercer botón es el Negative Pressure, con el que regulas el nivel de succión."
  },
  {
   "start": 28.44,
   "end": 34.28,
   "text": "cada vez que lo presiones la intensidad de succión aumentará si es su primera vez utilizando el humo"
  },
  {
   "start": 34.28,
   "end": 40.52,
   "text": "body comienza entre los niveles 1 a 3 prueba siempre desde el nivel más bajo y aumenta"
  },
  {
   "start": 40.52,
   "end": 46.6,
   "text": "gradualmente según lo que tu piel tolere recuerda debe sentir la succión pero nunca dolor si se"
  },
  {
   "start": 46.6,
   "end": 51.98,
   "text": "siente demasiado fuerte baja la intensidad aplica más aceite y mantiene el dispositivo en movimiento"
  }
 ],
