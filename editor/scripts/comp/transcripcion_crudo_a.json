  {
   "start": 0.0,
   "end": 1.54,
   "text": "Ah, ahí está grabando la barata."
  },
  {
   "start": 5.34,
   "end": 10.12,
   "text": "Dice, aplica aceite en ambas piernas y glúteos, o sea, la acción."
  },
  {
   "start": 10.8,
   "end": 14.14,
   "text": "Entonces, empezamos preparando la piel."
  },
  {
   "start": 14.48,
   "end": 15.16,
   "text": "Hola."
  },
  {
   "start": 15.58,
   "end": 16.2,
   "text": "¿Cuántas?"
  },
  {
   "start": 16.28,
   "end": 17.16,
   "text": "¿Cómo se dio?"
  },
  {
   "start": 18.5,
   "end": 20.92,
   "text": "Están allá en la bolsita que están afuera, Gita."
  },
  {
   "start": 21.02,
   "end": 21.66,
   "text": "¿Cuántos?"
  },
  {
   "start": 22.26,
   "end": 26.48,
   "text": "Yo saqué uno, creo que quedan 12."
  },
  {
   "start": 28.6,
   "end": 37.88,
   "text": "Es más, vamos a preparar toda la piel, podemos grabar la preparación del abdomen."
  },
  {
   "start": 50.84,
   "end": 53.58,
   "text": "Es importante no salir de las horas para que no se sienta."
  },
  {
   "start": 65.52,
   "end": 67.02,
   "text": "a ver Natalia"
  },
  {
   "start": 67.02,
   "end": 69.46,
   "text": "cuando dices acción exacta"
  },
  {
   "start": 69.46,
   "end": 71.46,
   "text": "vas a hablar al mismo tiempo"
  },
  {
   "start": 73.1,
   "end": 73.66,
   "text": "no"
  },
  {
   "start": 73.66,
   "end": 75.66,
   "text": "porque la acción es exacta"
  },
  {
   "start": 75.66,
   "end": 77.5,
   "text": "entonces eso es lo que estás haciendo"
  },
  {
   "start": 77.5,
   "end": 78.78,
   "text": "preparando la piel"
  },
  {
   "start": 79.36,
   "end": 80.7,
   "text": "duele más rico eso"
  },
  {
   "start": 84.2,
   "end": 85.4,
   "text": "¿te vas a hacer una silla?"
  },
  {
   "start": 85.68,
   "end": 85.88,
   "text": "no"
  },
  {
   "start": 91.91999999999999,
   "end": 93.32,
   "text": "Gracias."
  },
  {
   "start": 142.44,
   "end": 143.7,
   "text": "Ahí está."
  },
  {
   "start": 152.48,
   "end": 154.38,
   "text": "Te tienes que acercar, Nata, un poquito."
  },
  {
   "start": 187.42000000000002,
   "end": 202.92,
   "text": "Bueno, ahora vamos a preparar la piel de las piernas."
  },
  {
   "start": 216.42000000000002,
   "end": 217.94,
   "text": "Ay, está como perdida"
  },
  {
   "start": 219.4,
   "end": 221.64,
   "text": "Yo creo que tenemos que ponerlas como"
  },
  {
   "start": 221.64,
   "end": 223.2,
   "text": "No sé, como está mal"
  },
  {
   "start": 231.4,
   "end": 233.88,
   "text": "Trata de hacerlo como con una gelita de zanata"
  },
  {
   "start": 239.06,
   "end": 244.72,
   "text": "¿Qué es lo que se llama?"
  },
  {
   "start": 263.88,
   "end": 292.44,
   "text": "Bien, vamos a ver."
  },
  {
   "start": 293.88,
   "end": 294.3,
