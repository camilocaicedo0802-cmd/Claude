  },
  {
   "start": 331.14000000000004,
   "end": 332.54,
   "text": "Gracias."
  },
  {
   "start": 361.7,
   "end": 364.48,
   "text": "Muflo derecho, realiza la línea ascendente."
  },
  {
   "start": 364.64,
   "end": 370.28,
