{
 "model": "large-v3-turbo",
 "duration": 80.5746875,
 "segments": [
  {
   "start": 0.9800000000000006,
   "end": 9.82,
   "text": "Ahora vamos con la preparación de las piernas. Antes de utilizar el Luma Body, prepara ambas piernas con un masaje manual suave."
  },
  {
   "start": 10.86,
   "end": 23.92,
   "text": "Comienza aplicando suficiente aceite desde la pantorrilla y distribúyelo con movimientos ascendentes, desde encima del tobillo hasta llegar justo antes de la parte posterior de la rodilla."
  },
  {
   "start": 23.92,
   "end": 31.08,
   "text": "Al llegar a esta zona, realiza unos movimientos circulares muy suaves, sin presionar directamente ni causar molestia."
  },
  {
   "start": 31.92,
   "end": 40.98,
   "text": "Luego continúa desde encima de la rodilla hacia la parte superior del muslo, deslizando las manos lentamente en dirección."
  },
  {
   "start": 43.36,
   "end": 52.34,
   "text": "Luego continúa desde encima de la rodilla hacia la parte superior del muslo, deslizando las manos lentamente en dirección ascendente."
  },
  {
   "start": 53.12,
   "end": 58.64,
   "text": "Cuando te acerques a la zona inguinal, disminuye la presión y termina el movimiento antes de llegar a la ingle"
  },
  {
   "start": 59.239999999999995,
   "end": 70.34,
   "text": "Repite la misma secuencia en la otra pierna durante aproximadamente 1 o 2 minutos"
  },
  {
   "start": 70.34,
   "end": 74.12,
   "text": "Recuerda esta preparación, debes sentirse suave y agradable"
  },
  {
   "start": 74.12,
   "end": 79.84,
   "text": "No necesitas aplicar fuerza para dejar la piel lista antes de comenzar tu rutina con Luma Ode"
  }
 ],
