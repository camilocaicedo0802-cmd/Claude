{
 "model": "large-v3-turbo",
 "duration": 69.354,
 "segments": [
  {
   "start": 0.0,
   "end": 3.82,
   "text": "Hoy integraremos diferentes zonas en una sola rutina."
  },
  {
   "start": 4.0,
   "end": 8.4,
   "text": "Aplica el aceite únicamente en la zona que vas a trabajar para conservar el deslizamiento."
  },
  {
   "start": 8.68,
   "end": 11.0,
   "text": "Empezamos con 3 minutos en cada pierna."
  },
  {
   "start": 11.34,
   "end": 16.22,
   "text": "Divide la zona en líneas y trabaja siempre con movimientos ascendentes y continuos."
  },
  {
   "start": 16.54,
   "end": 21.44,
   "text": "Realiza líneas ascendentes desde la parte baja hacia arriba del muslo."
  },
  {
   "start": 22.02,
   "end": 26.42,
   "text": "Continúa durante 4 minutos en abdomen y laterales."
  },
  {
   "start": 26.42,
   "end": 31.54,
   "text": "Mantén una intensidad baja y evita pasar directamente sobre el ombligo"
  },
  {
   "start": 31.54,
   "end": 34.88,
   "text": "Realiza círculos amplios y movimientos suaves"
  },
  {
   "start": 34.88,
   "end": 40.96,
   "text": "Movimientos de arrastre desde la espalda hacia la cintura bajando por la ingle"
  },
  {
   "start": 40.96,
   "end": 47.18,
   "text": "Trabaja los glúteos durante 3 minutos con movimientos circulares y barridos ascendentes"
  },
  {
   "start": 47.18,
   "end": 50.8,
   "text": "Haz círculos amplios alternando ambos lados"
  },
  {
   "start": 50.8,
   "end": 53.46,
   "text": "Finaliza con 30 segundos en cada brazo"
  },
  {
   "start": 53.46,
   "end": 56.24,
   "text": "Los brazos puedes hacerlo solo con tus manos"
  },
  {
   "start": 56.24,
   "end": 60.24,
   "text": "O si lo vas a hacer con el dispositivo, recuerda no pasar sobre las articulaciones."
  },
  {
   "start": 61.06,
   "end": 69.26,
   "text": "¡Y listo! Tu rutina completa de 15 minutos para trabajar diferentes zonas sin necesidad de utilizar una intensidad dolorosa."
  }
 ],
