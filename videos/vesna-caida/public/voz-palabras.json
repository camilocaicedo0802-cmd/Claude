{
 "voz": "es-US-AlonsoNeural",
 "duracion": 69.41,
 "frases": [
  {
   "i": 0,
   "texto": "Esta mujer cayó desde más de diez mil metros de altura…",
   "seccion": "gancho",
   "inicio": 0.0,
   "fin": 2.93
  },
  {
   "i": 1,
   "texto": "¡sin paracaídas!",
   "seccion": "gancho",
   "inicio": 3.15,
   "fin": 4.44
  },
  {
   "i": 2,
   "texto": "Y sobrevivió.",
   "seccion": "gancho",
   "inicio": 4.96,
   "fin": 6.01
  },
  {
   "i": 3,
   "texto": "Básicamente, tuvo el peor vuelo de su vida,",
   "seccion": "gancho",
   "inicio": 6.63,
   "fin": 9.19
  },
  {
   "i": 4,
   "texto": "pero también el mejor aterrizaje de la historia.",
   "seccion": "gancho",
   "inicio": 9.31,
   "fin": 11.79
  },
  {
   "i": 5,
   "texto": "Se llamaba Vesna.",
   "seccion": "contexto",
   "inicio": 12.31,
   "fin": 13.48
  },
  {
   "i": 6,
   "texto": "Tenía 23 años, y era azafata.",
   "seccion": "contexto",
   "inicio": 13.68,
   "fin": 16.21
  },
  {
   "i": 7,
   "texto": "Terminó en ese avión por una confusión con otra compañera.",
   "seccion": "contexto",
   "inicio": 16.63,
   "fin": 19.71
  },
  {
   "i": 8,
   "texto": "Sí, un error de oficina.",
   "seccion": "contexto",
   "inicio": 19.97,
   "fin": 21.9
  },
  {
   "i": 9,
   "texto": "Pero 46 minutos después…",
   "seccion": "giro",
   "inicio": 22.42,
   "fin": 24.9
  },
  {
   "i": 10,
   "texto": "¡Bum!",
   "seccion": "giro",
   "inicio": 25.32,
   "fin": 25.81
  },
  {
   "i": 11,
   "texto": "Una explosión destrozó el avión en pleno cielo.",
   "seccion": "giro",
   "inicio": 26.23,
   "fin": 28.64
  },
  {
   "i": 12,
   "texto": "La aeronave se partió en tres.",
   "seccion": "giro",
   "inicio": 28.92,
   "fin": 30.79
  },
  {
   "i": 13,
   "texto": "Y Vesna cayó junto a los restos.",
   "seccion": "giro",
   "inicio": 30.97,
   "fin": 33.16
  },
  {
   "i": 14,
   "texto": "¿Su secreto para sobrevivir?",
   "seccion": "secreto",
   "inicio": 33.68,
   "fin": 35.47
  },
  {
   "i": 15,
   "texto": "Quedó atrapada en la parte trasera del fuselaje,",
   "seccion": "secreto",
   "inicio": 35.97,
   "fin": 38.39
  },
  {
   "i": 16,
   "texto": "junto a un carrito de comida.",
   "seccion": "secreto",
   "inicio": 38.51,
   "fin": 40.22
  },
  {
   "i": 17,
   "texto": "Sí, el carrito de los refrigerios terminó siendo parte de su equipo de supervivencia.",
   "seccion": "secreto",
   "inicio": 40.64,
   "fin": 45.24
  },
  {
   "i": 18,
   "texto": "¡Empleado del mes!",
   "seccion": "secreto",
   "inicio": 45.48,
   "fin": 46.71
  },
  {
   "i": 19,
   "texto": "Los restos cayeron sobre un bosque nevado.",
   "seccion": "rescate",
   "inicio": 47.27,
   "fin": 49.65
  },
  {
   "i": 20,
   "texto": "Un médico la encontró, y consiguió auxiliarla.",
   "seccion": "rescate",
   "inicio": 49.87,
   "fin": 52.73
  },
  {
   "i": 21,
   "texto": "Vesna estuvo 27 días en coma.",
   "seccion": "recuperacion",
   "inicio": 53.19,
   "fin": 55.83
  },
  {
   "i": 22,
   "texto": "Sufrió heridas gravísimas…",
   "seccion": "recuperacion",
   "inicio": 56.09,
   "fin": 57.95
  },
  {
   "i": 23,
   "texto": "¡pero volvió a caminar!",
   "seccion": "recuperacion",
   "inicio": 58.27,
   "fin": 59.46
  },
  {
   "i": 24,
   "texto": "Y hasta consiguió un récord Guinness.",
   "seccion": "recuperacion",
   "inicio": 59.9,
   "fin": 61.91
  },
  {
   "i": 25,
   "texto": "Veredicto: ¡verdad!",
   "seccion": "veredicto",
   "inicio": 62.43,
   "fin": 64.19
  },
  {
   "i": 26,
   "texto": "Después de eso, hasta las turbulencias debían parecerle un masaje.",
   "seccion": "cierre",
   "inicio": 64.67,
   "fin": 68.71
  }
 ],
