{
 "voz": "Gemini 2.5 Flash TTS · Charon",
 "duracion": 55.739,
 "frases": [
  {
   "i": 0,
   "texto": "Un chico de diecisiete años hackeó Ge te a seis... desde la tele de un hotel.",
   "seccion": "gancho",
   "inicio": 0.0,
   "fin": 4.62
  },
  {
   "i": 1,
   "texto": "Mira, la policía ya lo había atrapado por hackear otras empresas.",
   "seccion": "mira",
   "inicio": 4.82,
   "fin": 7.42
  },
  {
   "i": 2,
   "texto": "Le quitaron la computadora y lo llevaron a un hotel, para protegerlo.",
   "seccion": "mira",
   "inicio": 7.64,
   "fin": 10.74
  },
  {
   "i": 3,
   "texto": "Sin computadora... ¿qué podía hacer?",
   "seccion": "mira",
   "inicio": 10.82,
   "fin": 12.3
  },
  {
   "i": 4,
   "texto": "Primero, se mete al chat interno de Rockstar.",
   "seccion": "escalada",
   "inicio": 12.38,
   "fin": 14.48
  },
  {
   "i": 5,
   "texto": "Después, a sus archivos secretos.",
   "seccion": "escalada",
   "inicio": 14.6,
   "fin": 15.94
  },
  {
   "i": 6,
   "texto": "Y un domingo... sube noventa videos de Ge te a seis a un foro.",
   "seccion": "escalada",
   "inicio": 16.06,
   "fin": 18.32
  },
  {
   "i": 7,
   "texto": "Y en internet se ríen:",
   "seccion": "burla",
   "inicio": 18.32,
   "fin": 19.3
  },
  {
   "i": 8,
   "texto": "¡Es falso!",
   "seccion": "burla",
   "inicio": 19.98,
   "fin": 20.88
  },
  {
   "i": 9,
   "texto": "¡Eso parece de PlayStation dos!",
   "seccion": "burla",
   "inicio": 21.58,
   "fin": 23.02
  },
  {
   "i": 10,
   "texto": "Hasta que él escribe en el chat de los empleados:",
   "seccion": "amenaza",
   "inicio": 23.92,
   "fin": 26.08
  },
  {
   "i": 11,
   "texto": "Si no me contactan en veinticuatro horas... publico el código del juego.",
   "seccion": "amenaza",
   "inicio": 26.08,
   "fin": 31.46
  },
  {
   "i": 12,
   "texto": "Y Rockstar lo confirma:",
   "seccion": "giro",
   "inicio": 31.68,
   "fin": 32.78
  },
  {
   "i": 13,
   "texto": "los videos son reales.",
   "seccion": "giro",
   "inicio": 33.26,
   "fin": 34.74
  },
  {
   "i": 14,
   "texto": "¿Y cómo lo hizo sin computadora?",
   "seccion": "giro",
   "inicio": 34.8,
   "fin": 36.2
  },
  {
   "i": 15,
   "texto": "Con un Fire Stick: el aparatito para ver series en la tele.",
   "seccion": "mecanismo",
   "inicio": 36.34,
   "fin": 38.72
  },
  {
   "i": 16,
   "texto": "Lo enchufa, usa su celular... y entra.",
   "seccion": "mecanismo",
   "inicio": 38.72,
   "fin": 40.68
  },
  {
   "i": 17,
   "texto": "La policía lo había escondido ahí para protegerlo...",
   "seccion": "mecanismo",
   "inicio": 40.84,
   "fin": 42.82
  },
  {
   "i": 18,
   "texto": "y le dio el cuarto perfecto para hackear.",
   "seccion": "mecanismo",
   "inicio": 42.82,
   "fin": 44.68
  },
  {
   "i": 19,
   "texto": "A Rockstar le costó cinco millones de dólares.",
   "seccion": "remate",
   "inicio": 44.78,
   "fin": 47.32
  },
  {
   "i": 20,
   "texto": "A él, un hospital de seguridad, sin fecha de salida.",
   "seccion": "remate",
   "inicio": 47.58,
   "fin": 50.32
  },
  {
   "i": 21,
   "texto": "Todo por un aparatito de cuarenta dólares... enchufado a la tele de un hotel.",
   "seccion": "remate",
   "inicio": 50.82,
   "fin": 55.5
  }
 ],
