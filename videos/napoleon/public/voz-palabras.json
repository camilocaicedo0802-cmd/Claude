{
 "voz": "Gemini 2.5 Flash TTS · Charon",
 "duracion": 55.927,
 "frases": [
  {
   "i": 0,
   "texto": "¡Napoleón era más alto que el francés promedio!",
   "seccion": "gancho",
   "inicio": 0.0,
   "fin": 2.746
  },
  {
   "i": 1,
   "texto": "Y lo recordamos enano... por culpa de un dibujante inglés.",
   "seccion": "gancho",
   "inicio": 3.018,
   "fin": 7.145
  },
  {
   "i": 2,
   "texto": "En mil ochocientos dos, Napoleón es el hombre más poderoso de Francia.",
   "seccion": "desarrollo",
   "inicio": 7.691,
   "fin": 11.727
  },
  {
   "i": 3,
   "texto": "Pero en Londres... un caricaturista lo odia.",
   "seccion": "conflicto",
   "inicio": 12.018,
   "fin": 15.327
  },
  {
   "i": 4,
   "texto": "Lo dibuja diminuto, con berrinches de niño, y le pone un apodo:",
   "seccion": "desarrollo",
   "inicio": 15.782,
   "fin": 19.818
  },
  {
   "i": 5,
   "texto": "¡Little Boney!",
   "seccion": "conflicto",
   "inicio": 20.227,
   "fin": 21.045
  },
  {
   "i": 6,
   "texto": "Los periódicos lo copian por toda Europa.",
   "seccion": "desarrollo",
   "inicio": 21.455,
   "fin": 23.636
  },
  {
   "i": 7,
   "texto": "Cuando muere, en mil ochocientos veintiuno, la autopsia dice: cinco pies y dos pulgadas.",
   "seccion": "desarrollo",
   "inicio": 24.091,
   "fin": 29.273
  },
  {
   "i": 8,
   "texto": "En Inglaterra eso es...",
   "seccion": "conflicto",
   "inicio": 29.682,
   "fin": 31.154
  },
  {
   "i": 9,
   "texto": "¡uno cincuenta y siete!",
   "seccion": "conflicto",
   "inicio": 31.655,
   "fin": 32.382
  },
  {
   "i": 10,
   "texto": "Pero eran pulgadas francesas, más largas.",
   "seccion": "desarrollo",
   "inicio": 32.836,
   "fin": 35.51
  },
  {
   "i": 11,
   "texto": "¿Cuánto medía de verdad?",
   "seccion": "conflicto",
   "inicio": 35.918,
   "fin": 36.955
  },
  {
   "i": 12,
   "texto": "¡Casi uno sesenta y nueve!",
   "seccion": "conflicto",
   "inicio": 37.455,
   "fin": 38.781
  },
  {
   "i": 13,
   "texto": "¿Y el francés promedio?",
   "seccion": "conflicto",
   "inicio": 39.236,
   "fin": 40.309
  },
  {
   "i": 14,
   "texto": "Unos uno sesenta y cinco.",
   "seccion": "desarrollo",
   "inicio": 40.309,
   "fin": 41.764
  },
  {
   "i": 15,
   "texto": "Para colmo, siempre aparecía rodeado de su guardia: soldados elegidos por altos.",
   "seccion": "desarrollo",
   "inicio": 42.309,
   "fin": 46.564
  },
  {
   "i": 16,
   "texto": "Y el pequeño cabo era un apodo cariñoso, no una medida.",
   "seccion": "desarrollo",
   "inicio": 46.891,
   "fin": 49.8
  },
  {
   "i": 17,
   "texto": "Veredicto: ¡mito!",
   "seccion": "veredicto",
   "inicio": 50.391,
   "fin": 52.045
  },
  {
   "i": 18,
   "texto": "¿Emperador bajito... o víctima del primer meme de la historia?",
   "seccion": "pregunta",
   "inicio": 52.591,
   "fin": 55.609
  }
 ],
