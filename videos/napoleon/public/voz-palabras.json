{
 "voz": "es-US-PalomaNeural",
 "duracion": 45.12,
 "frases": [
  {
   "i": 0,
   "texto": "¡Napoleón era más alto que el francés promedio!",
   "seccion": "gancho",
   "inicio": 0.0,
   "fin": 2.03,
   "tono_objetivo": 283,
   "tono_medido": 282
  },
  {
   "i": 1,
   "texto": "Y lo recordamos enano por culpa de un dibujante inglés.",
   "seccion": "gancho",
   "inicio": 2.19,
   "fin": 4.93,
   "tono_objetivo": 283,
   "tono_medido": 273
  },
  {
   "i": 2,
   "texto": "En 1802, Napoleón es el hombre más poderoso de Francia.",
   "seccion": "desarrollo",
   "inicio": 5.25,
   "fin": 8.54,
   "tono_objetivo": 186,
   "tono_medido": 185
  },
  {
   "i": 3,
   "texto": "Pero en Londres, un caricaturista lo odia.",
   "seccion": "conflicto",
   "inicio": 8.72,
   "fin": 10.71,
   "tono_objetivo": 248,
   "tono_medido": 245
  },
  {
   "i": 4,
   "texto": "Lo dibuja diminuto, con berrinches de niño, y le pone un apodo:",
   "seccion": "desarrollo",
   "inicio": 10.97,
   "fin": 14.26,
   "tono_objetivo": 186,
   "tono_medido": 185
  },
  {
   "i": 5,
   "texto": "¡Lítel Bóni!",
   "seccion": "conflicto",
   "inicio": 14.38,
   "fin": 15.09,
   "tono_objetivo": 248,
   "tono_medido": 240
  },
  {
   "i": 6,
   "texto": "Los periódicos lo copian por toda Europa.",
   "seccion": "desarrollo",
   "inicio": 15.33,
   "fin": 17.29,
   "tono_objetivo": 186,
   "tono_medido": 185
  },
  {
   "i": 7,
   "texto": "Cuando muere, en 1821, la autopsia dice: cinco pies y dos pulgadas.",
   "seccion": "desarrollo",
   "inicio": 17.59,
   "fin": 22.16,
   "tono_objetivo": 186,
   "tono_medido": 188
  },
  {
   "i": 8,
   "texto": "En Inglaterra eso es…",
   "seccion": "conflicto",
   "inicio": 22.36,
   "fin": 23.62,
   "tono_objetivo": 248,
   "tono_medido": 247
  },
  {
   "i": 9,
   "texto": "¡uno cincuenta y siete!",
   "seccion": "conflicto",
   "inicio": 23.78,
   "fin": 24.82,
   "tono_objetivo": 248,
   "tono_medido": 240
  },
  {
   "i": 10,
   "texto": "Pero eran pulgadas francesas, más largas.",
   "seccion": "desarrollo",
   "inicio": 25.1,
   "fin": 27.26,
   "tono_objetivo": 186,
   "tono_medido": 188
  },
  {
   "i": 11,
   "texto": "¿Cuánto medía de verdad?",
   "seccion": "conflicto",
   "inicio": 27.42,
   "fin": 28.51,
   "tono_objetivo": 248,
   "tono_medido": 247
  },
  {
   "i": 12,
   "texto": "¡Casi uno sesenta y nueve!",
   "seccion": "conflicto",
   "inicio": 28.67,
   "fin": 29.83,
   "tono_objetivo": 248,
   "tono_medido": 250
  },
  {
   "i": 13,
   "texto": "¿Y el francés promedio?",
   "seccion": "conflicto",
   "inicio": 30.05,
   "fin": 31.16,
   "tono_objetivo": 248,
   "tono_medido": 247
  },
  {
   "i": 14,
   "texto": "Unos uno sesenta y cinco.",
   "seccion": "desarrollo",
   "inicio": 31.3,
   "fin": 32.57,
   "tono_objetivo": 186,
   "tono_medido": 185
  },
  {
   "i": 15,
   "texto": "Para colmo, siempre aparecía rodeado de su guardia, soldados elegidos por altos.",
   "seccion": "desarrollo",
   "inicio": 32.89,
   "fin": 36.92,
   "tono_objetivo": 186,
   "tono_medido": 188
  },
  {
   "i": 16,
   "texto": "Y el pequeño cabo era un apodo cariñoso, no una medida.",
   "seccion": "desarrollo",
   "inicio": 37.08,
   "fin": 39.9,
   "tono_objetivo": 186,
   "tono_medido": 188
  },
  {
   "i": 17,
   "texto": "Veredicto: ¡mito!",
   "seccion": "veredicto",
   "inicio": 40.22,
   "fin": 41.28,
   "tono_objetivo": 248,
   "tono_medido": 247
  },
  {
   "i": 18,
   "texto": "¿Emperador bajito… o víctima del primer meme de la historia?",
   "seccion": "pregunta",
   "inicio": 41.58,
   "fin": 44.42,
   "tono_objetivo": 248,
   "tono_medido": 250
  }
 ],
