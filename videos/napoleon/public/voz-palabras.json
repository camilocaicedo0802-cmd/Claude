{
 "voz": "ElevenLabs v3 · Laura",
 "duracion": 49.782,
 "frases": [
  {
   "i": 0,
   "texto": "¡Napoleón era más alto que el francés promedio!",
   "seccion": "gancho",
   "inicio": 0.0,
   "fin": 2.636
  },
  {
   "i": 1,
   "texto": "Y lo recordamos enano... por culpa de un dibujante inglés.",
   "seccion": "gancho",
   "inicio": 2.818,
   "fin": 6.054
  },
  {
   "i": 2,
   "texto": "En mil ochocientos dos, Napoleón es el hombre más poderoso de Francia.",
   "seccion": "desarrollo",
   "inicio": 6.436,
   "fin": 10.145
  },
  {
   "i": 3,
   "texto": "Pero en Londres... un caricaturista lo odia.",
   "seccion": "conflicto",
   "inicio": 10.382,
   "fin": 12.764
  },
  {
   "i": 4,
   "texto": "Lo dibuja diminuto, con berrinches de niño, y le pone un apodo:",
   "seccion": "desarrollo",
   "inicio": 13.0,
   "fin": 16.564
  },
  {
   "i": 5,
   "texto": "¡Little Boney!",
   "seccion": "conflicto",
   "inicio": 16.8,
   "fin": 17.491
  },
  {
   "i": 6,
   "texto": "Los periódicos lo copian por toda Europa.",
   "seccion": "desarrollo",
   "inicio": 17.727,
   "fin": 19.746
  },
  {
   "i": 7,
   "texto": "Cuando muere, en mil ochocientos veintiuno, la autopsia dice: cinco pies y dos pulgadas.",
   "seccion": "desarrollo",
   "inicio": 19.745,
   "fin": 25.128
  },
  {
   "i": 8,
   "texto": "En Inglaterra eso es...",
   "seccion": "conflicto",
   "inicio": 25.364,
   "fin": 26.764
  },
  {
   "i": 9,
   "texto": "¡uno cincuenta y siete!",
   "seccion": "conflicto",
   "inicio": 26.764,
   "fin": 28.2
  },
  {
   "i": 10,
   "texto": "Pero eran pulgadas francesas, más largas.",
   "seccion": "desarrollo",
   "inicio": 28.509,
   "fin": 30.8
  },
  {
   "i": 11,
   "texto": "¿Cuánto medía de verdad?",
   "seccion": "conflicto",
   "inicio": 31.036,
   "fin": 32.036
  },
  {
   "i": 12,
   "texto": "¡Casi uno sesenta y nueve!",
   "seccion": "conflicto",
   "inicio": 32.309,
   "fin": 33.691
  },
  {
   "i": 13,
   "texto": "¿Y el francés promedio?",
   "seccion": "conflicto",
   "inicio": 33.927,
   "fin": 35.128
  },
  {
   "i": 14,
   "texto": "Unos uno sesenta y cinco.",
   "seccion": "desarrollo",
   "inicio": 35.4,
   "fin": 36.673
  },
  {
   "i": 15,
   "texto": "Para colmo, siempre aparecía rodeado de su guardia: soldados elegidos por altos.",
   "seccion": "desarrollo",
   "inicio": 37.018,
   "fin": 41.109
  },
  {
   "i": 16,
   "texto": "Y el pequeño cabo era un apodo cariñoso, no una medida.",
   "seccion": "desarrollo",
   "inicio": 41.109,
   "fin": 44.691
  },
  {
   "i": 17,
   "texto": "Veredicto: ¡mito!",
   "seccion": "veredicto",
   "inicio": 45.073,
   "fin": 46.273
  },
  {
   "i": 18,
   "texto": "¿Emperador bajito... o víctima del primer meme de la historia?",
   "seccion": "pregunta",
   "inicio": 46.636,
   "fin": 49.546
  }
 ],
