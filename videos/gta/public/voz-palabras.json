{
 "voz": "Gemini 2.5 Flash TTS · Charon",
 "duracion": 58.446,
 "frases": [
  {
   "i": 0,
   "texto": "¡GTA existe por un bug!",
   "seccion": "gancho",
   "inicio": 0.0,
   "fin": 2.273
  },
  {
   "i": 1,
   "texto": "Un error que volvía loca a la policía...",
   "seccion": "gancho",
   "inicio": 2.714,
   "fin": 4.768
  },
  {
   "i": 2,
   "texto": "y eso ni siquiera es lo más loco de su historia.",
   "seccion": "gancho",
   "inicio": 5.0,
   "fin": 7.145
  },
  {
   "i": 3,
   "texto": "Al principio no era un juego de criminales: era de carreras, policías contra ladrones.",
   "seccion": "origen",
   "inicio": 7.623,
   "fin": 12.132
  },
  {
   "i": 4,
   "texto": "Y era... ¡aburridísimo!",
   "seccion": "origen",
   "inicio": 12.577,
   "fin": 14.905
  },
  {
   "i": 5,
   "texto": "Tan aburrido que estuvo a punto de cancelarse.",
   "seccion": "escalon",
   "inicio": 15.382,
   "fin": 17.527
  },
  {
   "i": 6,
   "texto": "Hasta que un error en el código vuelve locos a los policías:",
   "seccion": "escalon2",
   "inicio": 17.95,
   "fin": 21.386
  },
  {
   "i": 7,
   "texto": "ya no te persiguen...",
   "seccion": "escalon2",
   "inicio": 21.386,
   "fin": 23.095
  },
  {
   "i": 8,
   "texto": "¡te embisten, te encierran, te sacan de la calle!",
   "seccion": "escalon2",
   "inicio": 23.305,
   "fin": 25.687
  },
  {
   "i": 9,
   "texto": "Y los que lo prueban no quieren soltarlo.",
   "seccion": "climax",
   "inicio": 26.232,
   "fin": 28.214
  },
  {
   "i": 10,
   "texto": "¿Lo más divertido?",
   "seccion": "climax",
   "inicio": 28.659,
   "fin": 29.404
  },
  {
   "i": 11,
   "texto": "¡Escaparse de esos policías locos!",
   "seccion": "climax",
   "inicio": 29.959,
   "fin": 31.468
  },
  {
   "i": 12,
   "texto": "¿Y arreglaron el bug?",
   "seccion": "climax",
   "inicio": 31.814,
   "fin": 32.868
  },
  {
   "i": 13,
   "texto": "¡Al contrario!",
   "seccion": "climax",
   "inicio": 33.15,
   "fin": 33.786
  },
  {
   "i": 14,
   "texto": "Lo convirtieron en el juego...",
   "seccion": "climax",
   "inicio": 34.232,
   "fin": 35.614
  },
  {
   "i": 15,
   "texto": "y le pusieron Grand Theft Auto: robo de autos.",
   "seccion": "climax",
   "inicio": 35.809,
   "fin": 39.068
  },
  {
   "i": 16,
   "texto": "Pero lo más loco vino después.",
   "seccion": "golpe",
   "inicio": 39.564,
   "fin": 41.454
  },
  {
   "i": 17,
   "texto": "Cuando en Inglaterra pidieron prohibirlo por violento...",
   "seccion": "golpe",
   "inicio": 41.927,
   "fin": 44.473
  },
  {
   "i": 18,
   "texto": "esa polémica la había inventado su propia distribuidora.",
   "seccion": "golpe",
   "inicio": 44.473,
   "fin": 48.127
  },
  {
   "i": 19,
   "texto": "Contrataron a un experto en escándalos para que todo el mundo hablara del juego.",
   "seccion": "golpe",
   "inicio": 48.509,
   "fin": 52.019
  },
  {
   "i": 20,
   "texto": "Y vaya que hablaron.",
   "seccion": "golpe",
   "inicio": 52.382,
   "fin": 53.4
  },
  {
   "i": 21,
   "texto": "Veredicto: ¡real!",
   "seccion": "veredicto",
   "inicio": 53.955,
   "fin": 55.318
  },
  {
   "i": 22,
   "texto": "¿Genios del marketing... o pura suerte?",
   "seccion": "pregunta",
   "inicio": 55.764,
   "fin": 58.146
  }
 ],
