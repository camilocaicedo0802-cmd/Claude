{
 "voz": "Gemini 2.5 Flash TTS · Charon",
 "duracion": 58.269,
 "frases": [
  {
   "i": 0,
   "texto": "¡Ge te a existe por un bug!",
   "seccion": "gancho",
   "inicio": 0.0,
   "fin": 2.6
  },
  {
   "i": 1,
   "texto": "Un error que volvía loca a la policía...",
   "seccion": "gancho",
   "inicio": 3.041,
   "fin": 5.077
  },
  {
   "i": 2,
   "texto": "y eso ni siquiera es lo más loco de su historia.",
   "seccion": "gancho",
   "inicio": 5.4,
   "fin": 7.473
  },
  {
   "i": 3,
   "texto": "Al principio no era un juego de criminales: era de carreras, policías contra ladrones.",
   "seccion": "origen",
   "inicio": 7.932,
   "fin": 12.478
  },
  {
   "i": 4,
   "texto": "Y era... ¡aburridísimo!",
   "seccion": "origen",
   "inicio": 12.868,
   "fin": 15.232
  },
  {
   "i": 5,
   "texto": "Tan aburrido que estuvo a punto de cancelarse.",
   "seccion": "escalon",
   "inicio": 15.673,
   "fin": 17.836
  },
  {
   "i": 6,
   "texto": "Hasta que un error en el código vuelve locos a los policías:",
   "seccion": "escalon2",
   "inicio": 18.25,
   "fin": 21.741
  },
  {
   "i": 7,
   "texto": "ya no te persiguen...",
   "seccion": "escalon2",
   "inicio": 22.027,
   "fin": 23.082
  },
  {
   "i": 8,
   "texto": "¡te embisten, te encierran, te sacan de la calle!",
   "seccion": "escalon2",
   "inicio": 23.082,
   "fin": 25.882
  },
  {
   "i": 9,
   "texto": "Y los que lo prueban no quieren soltarlo.",
   "seccion": "climax",
   "inicio": 26.318,
   "fin": 28.391
  },
  {
   "i": 10,
   "texto": "¿Lo más divertido?",
   "seccion": "climax",
   "inicio": 28.832,
   "fin": 29.595
  },
  {
   "i": 11,
   "texto": "¡Escaparse de esos policías locos!",
   "seccion": "climax",
   "inicio": 30.132,
   "fin": 31.659
  },
  {
   "i": 12,
   "texto": "¿Y arreglaron el bug?",
   "seccion": "climax",
   "inicio": 31.905,
   "fin": 33.05
  },
  {
   "i": 13,
   "texto": "¡Al contrario!",
   "seccion": "climax",
   "inicio": 33.364,
   "fin": 34.019
  },
  {
   "i": 14,
   "texto": "Lo convirtieron en el juego...",
   "seccion": "climax",
   "inicio": 34.482,
   "fin": 35.809
  },
  {
   "i": 15,
   "texto": "y le pusieron Grand Theft Auto: robo de autos.",
   "seccion": "climax",
   "inicio": 36.045,
   "fin": 39.281
  },
  {
   "i": 16,
   "texto": "Pero lo más loco vino después.",
   "seccion": "golpe",
   "inicio": 39.759,
   "fin": 41.632
  },
  {
   "i": 17,
   "texto": "Cuando en Inglaterra pidieron prohibirlo por violento...",
   "seccion": "golpe",
   "inicio": 42.086,
   "fin": 44.669
  },
  {
   "i": 18,
   "texto": "esa polémica la había inventado su propia distribuidora.",
   "seccion": "golpe",
   "inicio": 44.868,
   "fin": 47.977
  },
  {
   "i": 19,
   "texto": "Contrataron a un experto en escándalos para que todo el mundo hablara del juego.",
   "seccion": "golpe",
   "inicio": 48.523,
   "fin": 51.887
  },
  {
   "i": 20,
   "texto": "Y vaya que hablaron.",
   "seccion": "golpe",
   "inicio": 52.214,
   "fin": 53.286
  },
  {
   "i": 21,
   "texto": "Veredicto: ¡real!",
   "seccion": "veredicto",
   "inicio": 54.15,
   "fin": 55.204
  },
  {
   "i": 22,
   "texto": "¿Genios del marketing... o pura suerte?",
   "seccion": "pregunta",
   "inicio": 55.745,
   "fin": 57.964
  }
 ],
